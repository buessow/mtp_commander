    <string name="help_view">Tap a text or FIT file to see what is in it. FIT files show their header and a table for each kind of message.</string>
    <string name="help_open">Tap a file to open it in another app. Files on an external device or in Google Drive are copied to the phone first.</string>
    <string name="help_search_copy_below">Tick search results to copy them. Open the folder to copy into in the list below, then press COPY.</string>
    <string name="help_search_copy_right">Tick search results to copy them. Open the folder to copy into in the list on the right, then press COPY.</string>
    <string name="help_search_delete">Tick search results to delete them. Nothing is deleted until you press DELETE.</string>
    <string name="help_copy_below">Tick files to copy them. Open the folder to copy into in the list below, then press COPY.</string>
    <string name="help_copy_right">Tick files to copy them. Open the folder to copy into in the list on the right, then press COPY.</string>
    <string name="help_delete">Tick files to delete them. Nothing is deleted until you press DELETE.</string>
