    <string name="app_name" translatable="false">MTP Commander</string>
    <string name="phone_access_title">Browse phone storage</string>
    <string name="phone_access_text">To show files in the phone\'s shared storage without choosing folders one by one, MTP Commander needs all-files access. In Settings, enable ‘Allow access to manage all files’ for this app. Browsing is read-only; you can continue using an MTP device if you decline.</string>
